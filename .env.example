# --- API ---
PROJECT_NAME=mekano-os-service
DOCKER_REGISTRY=ghcr.io/fiap-software-architecture-team
IMAGE_TAG=latest

# --- Database (RDS exclusivo do serviço de OS) ---
DB_USER=mekano_os
DB_PASSWORD=mekano_os

# --- Monolito Mekano-API (consultas de cliente, veículo, catálogo, estoque) ---
MEKANO_API_URL=http://localhost:8080

# --- Mensageria SNS/SQS (LocalStack em dev) ---
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_ENDPOINT_OVERRIDE=http://localhost:4566
OS_EVENTS_TOPIC_ARN=arn:aws:sns:us-east-1:000000000000:os-events.fifo
